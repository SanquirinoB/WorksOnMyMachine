{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "0.1.0",
  "FriendlyName": "CoreKit",
  "Description": "Reusable modules for starting new Unreal Engine projects.",
  "Category": "Gameplay",
  "CreatedBy": "Deltalo",
  "EnabledByDefault": false,
  "CanContainContent": true,
  "IsBetaVersion": true,
  "Plugins": [
    {
      "Name": "EnhancedInput",
      "Enabled": true
    },
    {
      "Name": "ModelViewViewModel",
      "Enabled": true
    }
  ],
  "Modules": [
    {
      "Name": "CoreKitData",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "CoreKitNavigation",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "CoreKitTween",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "CoreKitLoading",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "CoreKitSave",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "CoreKitActions",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "CoreKitFrontend",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "CoreKitActionsTests",
      "Type": "DeveloperTool",
      "LoadingPhase": "PostEngineInit",
      "TargetAllowList": [
        "Editor"
      ]
    },
    {
      "Name": "CoreKitActionsEditor",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit"
    },
    {
      "Name": "CoreKitBasicUI",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "CoreKitWeapons",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    }
  ]
}
