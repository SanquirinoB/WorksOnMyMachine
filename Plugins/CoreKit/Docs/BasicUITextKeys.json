    "key": "CoreKitBasicUISettings.PauseBody",
    "default": "Pause stays on Escape (Menu on a gamepad) so you can always stop the run. It cannot be rebound."
  },
  {
    "key": "CoreKitBasicUISettings.DisplayMode",
    "default": "Display mode"
  },
  {
    "key": "CoreKitBasicUISettings.DisplayModeBody",
    "default": "Fullscreen gives the lowest input latency. Motion blur ships off: projectiles stay readable during dashes."
  },
  {
    "key": "CoreKitBasicUISettings.Resolution",
    "default": "Resolution"
  },
  {
    "key": "CoreKitBasicUISettings.ResolutionBody",
    "default": "Rendering size. Your monitor's native resolution keeps text, keycaps and the crosshair sharp. Changes wait for APPLY."
  },
  {
    "key": "CoreKitBasicUISettings.FrameRate",
    "default": "Frame rate limit"
  },
  {
    "key": "CoreKitBasicUISettings.FrameRateBody",
    "default": "Caps the frame rate. Match your monitor's refresh rate for the steadiest aim; Unlimited lets the GPU run free."
  },
  {
    "key": "CoreKitBasicUISettings.VSync",
    "default": "V-Sync"
  },
  {
    "key": "CoreKitBasicUISettings.VSyncBody",
    "default": "Removes screen tearing at the cost of some input latency. With a frame rate limit you can usually leave it off."
  },
  {
    "key": "CoreKitBasicUISettings.MotionBlur",
    "default": "Motion blur"
  },
  {
    "key": "CoreKitBasicUISettings.MotionBlurBody",
    "default": "Blurs fast turns and dashes. It ships off so drones and their shots stay readable at speed."
  },
  {
    "key": "CoreKitBasicUISettings.Master",
    "default": "Master volume"
  },
  {
    "key": "CoreKitBasicUISettings.MasterBody",
