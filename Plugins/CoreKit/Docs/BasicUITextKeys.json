  {
    "key": "CoreKitBasicUISettings.RebindBody",
    "default": "Press any key or mouse button to assign. A key already in use swaps with this action. Escape cancels."
  },
  {
    "key": "CoreKitBasicUISettings.Sensitivity",
    "default": "Mouse sensitivity"
  },
  {
    "key": "CoreKitBasicUISettings.SensitivityBody",
    "default": "How fast the camera turns. Lower values make long rifle tracking steadier; higher values make it easier to turn on drones behind you."
  },
  {
    "key": "CoreKitBasicUISettings.Invert",
    "default": "Invert look Y"
  },
  {
    "key": "CoreKitBasicUISettings.InvertBody",
    "default": "Flips vertical look: pushing the mouse or stick forward looks down. Leave it off unless your hands already expect flight controls."
  },
  {
    "key": "CoreKitBasicUISettings.FOV",
    "default": "Field of view"
  },
  {
    "key": "CoreKitBasicUISettings.FOVBody",
    "default": "How much of the arena fits on screen. Wider shows drones closing in from the sides; narrower makes far targets bigger for the rifle."
  },
  {
    "key": "CoreKitBasicUISettings.DashNoInput",
    "default": "Dash with no input"
  },
  {
    "key": "CoreKitBasicUISettings.DashNoInputBody",
    "default": "Where Dash goes when no direction is held. Forward closes the gap for the katana; backward pulls you out of a slam ring."
  },
  {
    "key": "CoreKitBasicUISettings.DamageNumbers",
    "default": "Damage numbers"
  },
  {
    "key": "CoreKitBasicUISettings.DamageNumbersBody",
    "default": "Shows the damage of every hit above the target. Off keeps the screen clean; hit markers and kill confirms stay."
  },
  {
    "key": "CoreKitBasicUISettings.Shake",
    "default": "Screen shake"
  },
  {
    "key": "CoreKitBasicUISettings.ShakeBody",
    "default": "Camera shake from hits taken, Dash and the Heavy Mech's slam. Zero turns it off; Reduced motion turns it off too."
  },
  {
    "key": "CoreKitBasicUISettings.HudScale",
    "default": "HUD scale"
  },
  {
    "key": "CoreKitBasicUISettings.HudScaleBody",
    "default": "Size of every HUD block. The HUD stays inside the safe area at any scale."
  },
  {
    "key": "CoreKitBasicUISettings.Crosshair",
    "default": "Crosshair colour"
  },
  {
    "key": "CoreKitBasicUISettings.CrosshairBody",
    "default": "Colour of the crosshair dot and ticks. Pick the one that reads best against the arena; hit markers keep the colour of the active weapon."
  },
  {
    "key": "CoreKitBasicUISettings.ReducedMotion",
    "default": "Reduced motion"
  },
  {
    "key": "CoreKitBasicUISettings.ReducedMotionBody",
    "default": "Turns off screen shake, glitch, the FOV kick, speed lines and card parallax. Fades and colour changes stay, so nothing is lost."
  },
  {
    "key": "CoreKitBasicUISettings.Glyphs",
    "default": "Gamepad glyphs"
  },
  {
    "key": "CoreKitBasicUISettings.GlyphsBody",
    "default": "Which button icons a gamepad shows. AUTO follows the connected pad; pick XBOX or PLAYSTATION when your pad is shown wrong."
  },
